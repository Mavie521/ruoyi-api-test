            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="查用户列表（随机翻页）" enabled="true">
              <stringProp name="HTTPSampler.path">/system/user/list?pageNum=${__Random(1,20,pageNum)}&amp;pageSize=10</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
