      <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="JSR223 - 全局异常日志打印（失败自动输出接口/码/报文）">
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="script">if (!prev.isSuccessful()) {
    log.error(&quot;[FAIL] label=&quot; + prev.getSampleLabel() + &quot; code=&quot; + prev.getResponseCode() + &quot; msg=&quot; + prev.getResponseMessage());
    def body = prev.getResponseDataAsString();
    if (body != null &amp;&amp; body.length() &gt; 500) { body = body.substring(0, 500); }
    log.error(&quot;[RESP] &quot; + body);
}</stringProp>
        <stringProp name="scriptLanguage">groovy</stringProp>
      </JSR223Listener>
